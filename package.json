{
  "name": "sam-travels",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "check:architecture": "node scripts/check-architecture.mjs && npm run features:check",
    "verify": "npm run check:architecture && npm test && npm run build",
    "feature:create": "node scripts/create-feature.mjs",
    "cap:sync": "npm run build && cap sync android",
    "build:timeline-parity": "vite build --config vite.timeline-parity.config.ts",
    "features:discover": "node scripts/discover-features.mjs",
    "features:check": "node scripts/discover-features.mjs --check",
    "check:stage5": "node scripts/check-stage-5.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/core": "^7.4.3",
    "dexie": "^4.0.11",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "hash-wasm": "^4.12.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "fake-indexeddb": "^6.2.2",
    "typescript": "^5.9.2",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  }
}
